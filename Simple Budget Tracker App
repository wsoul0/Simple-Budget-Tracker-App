import tkinter as tk
from tkinter import messagebox


# Data Abstraction
expenses = []          # list of dictionaries




# Procedural Abstraction
def update_display():
   expense_list.delete(0, tk.END)


   total = 0
   for e in expenses:          # iteration
       expense_list.insert(tk.END, f"{e['name']} - ${e['amount']}")
       total += e['amount']


   total_label.config(text=f"Total Spending: ${total}")


   if total > 100:    # selection
       warning_label.config(text="⚠️ Over Budget!", fg="red")
   else:
       warning_label.config(text="")




def add_expense():
   name = entry_name.get()
   amount_text = entry_amount.get()


   if name == "" or amount_text == "":
       messagebox.showwarning("Input Error", "Please enter name AND amount.")
       return


   try:
       amount = float(amount_text)
   except ValueError:
       messagebox.showwarning("Input Error", "Amount must be a number.")
       return


   # Add to list (data abstraction)
   expenses.append({"name": name, "amount": amount})


   entry_name.delete(0, tk.END)
   entry_amount.delete(0, tk.END)


   update_display()




# GUI Setup
root = tk.Tk()
root.title("Simple Budget Tracker")


# Expense Name
tk.Label(root, text="Expense Name:").grid(row=0, column=0, padx=5, pady=5)
entry_name = tk.Entry(root)
entry_name.grid(row=0, column=1, padx=5, pady=5)


# Amount
tk.Label(root, text="Amount ($):").grid(row=1, column=0, padx=5, pady=5)
entry_amount = tk.Entry(root)
entry_amount.grid(row=1, column=1, padx=5, pady=5)


# Add button
add_button = tk.Button(root, text="Add Expense", command=add_expense)
add_button.grid(row=2, column=0, columnspan=2, pady=10)


# Listbox
expense_list = tk.Listbox(root, width=40)
expense_list.grid(row=3, column=0, columnspan=2, pady=10)


# Total spending label
total_label = tk.Label(root, text="Total Spending: $0")
total_label.grid(row=4, column=0, columnspan=2)


# Warning message
warning_label = tk.Label(root, text="", font=("Arial", 12, "bold"))
warning_label.grid(row=5, column=0, columnspan=2, pady=5)


root.mainloop()

